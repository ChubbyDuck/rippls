{
  "name": "rippls",
  "version": "0.0.1",
  "description": "An opinionated ticket-based agentic loops-runner",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "rippls": "dist/rippls.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChubbyDuck/rippls.git"
  },
  "keywords": [
    "cli",
    "loop",
    "harness",
    "tickets",
    "agents"
  ],
  "scripts": {
    "dev": "tsx --watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "vite build",
    "prepack": "pnpm build",
    "generate": "tsx bin/generate.ts",
    "clean-tickets": "tsx bin/clean.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@linear/sdk": "^93.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "date-fns": "^4.1.0",
    "effect": "4.0.0-rc.112",
    "rrule": "^2.8.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@effect/tsgo": "^0.37.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.19.4",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.12.0"
}
